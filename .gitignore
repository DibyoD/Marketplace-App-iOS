cat > .gitignore <<'EOF'
# Xcode
build/
DerivedData/
xcuserdata/
*.xcuserstate
*.xccheckout
*.moved-aside
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
*.xcscmblueprint

# Swift Package Manager
.build/
.swiftpm/
Packages/

# CocoaPods
Pods/

# Carthage
Carthage/Build/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# IDE
.idea/
.vscode/

# Logs and temporary files
*.log
*.tmp
*.temp
*.bak

# Environment and secrets
.env
.env.*
!.env.example
Secrets.swift
EOF